--- a/src/d3d9/d3d9_main.cpp
+++ b/src/d3d9/d3d9_main.cpp
@@ -18,7 +18,15 @@ namespace dxvk {
     if (!ppDirect3D9Ex)
       return D3DERR_INVALIDCALL;
 
-    *ppDirect3D9Ex = ref(new D3D9InterfaceEx( Extended ));
+    // Report an unusable Vulkan setup as a failed call (as D3D9 does), not an exception the
+    // host cannot catch across the library boundary.
+    try {
+      *ppDirect3D9Ex = ref(new D3D9InterfaceEx( Extended ));
+    } catch (const DxvkError& e) {
+      Logger::err(e.message());
+      *ppDirect3D9Ex = nullptr;
+      return D3DERR_NOTAVAILABLE;
+    }
     return D3D_OK;
   }
 }
