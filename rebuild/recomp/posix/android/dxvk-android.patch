diff --git a/src/vulkan/vulkan_loader.cpp b/src/vulkan/vulkan_loader.cpp
index f9d1e98d..1d3ef732 100644
--- a/src/vulkan/vulkan_loader.cpp
+++ b/src/vulkan/vulkan_loader.cpp
@@ -10,6 +10,17 @@
 namespace dxvk::vk {
 
   static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibrary() {
+#ifdef __ANDROID__
+    // A driver the host already loaded (e.g. a custom driver through adrenotools) hands its
+    // vkGetInstanceProcAddr over as a hex address.
+    if (const char* gipa = getenv("DXVK_VK_GET_INSTANCE_PROC_ADDR")) {
+      auto proc = reinterpret_cast<PFN_vkGetInstanceProcAddr>(uintptr_t(strtoull(gipa, nullptr, 16)));
+      if (proc) {
+        Logger::info("Vulkan: Using host-provided vkGetInstanceProcAddr");
+        return std::make_pair(HMODULE(nullptr), proc);
+      }
+    }
+#endif
     static const std::array<const char*, 2> dllNames = {{
 #ifdef _WIN32
       "winevulkan.dll",
