+    auto create = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+      pfnVkGetInstanceProcAddr(instance, "vkCreateAndroidSurfaceKHR"));
+    if (!create)
+      return VK_ERROR_EXTENSION_NOT_PRESENT;
+    VkAndroidSurfaceCreateInfoKHR ci = { VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR };
+    ci.window = info.info.android.window;
+    return create(instance, &ci, nullptr, pSurface);
+#endif
+
     return SDL_Vulkan_CreateSurface(window, instance, pSurface)
