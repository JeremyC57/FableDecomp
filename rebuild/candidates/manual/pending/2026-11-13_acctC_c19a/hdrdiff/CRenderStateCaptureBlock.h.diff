+    // through StartCaptureBlock(this), so VC7.1 cannot move the store above the call: the source order is store first), as the
+    // INLINE_DTOR opt-in's `Open = false; StateManager->RestoreCaptureBlock();`.
+    void Restore() { Open = false; StateManager->RestoreCaptureBlock(); }
+#else
     void Restore() { StateManager->RestoreCaptureBlock(); Open = false; }
+#endif
