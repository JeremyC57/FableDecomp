+#ifndef FABLE_ENGINE_CVOLUMELOCKEDBOX_H
+#define FABLE_ENGINE_CVOLUMELOCKEDBOX_H
+// NEW shared header (AUTH23 2026-11-22, row 0x00A68DE0 CVolumeTexture::LoadFromDataStream). Ego_d.pdb CVolumeLockedBox (class 0xBB5A, 24 bytes,
+// field list 0xBB59): Dimensions +0x00 (C3DExtentsI), RowPitch +0x0C, SlicePitch +0x10, PMem +0x14 (unsigned char*), all public, and two
+// constructors (LF_METHOD `CVolumeLockedBox`, 2 overloads); Ego_r.pdb has the same layout. The text is the model the landed
+// CVolumeTexture::Lock row 0x00A685E0 carries locally (that row and 0x00A68910 can move onto this header: queued, not done here).
+#include "rebuild_abi.h"
+#include "engine/C3DExtentsI.h"
+class CVolumeLockedBox {
+public:
+    C3DExtentsI    Dimensions;                                           // +0x00
+    long           RowPitch;                                             // +0x0c
+    long           SlicePitch;                                           // +0x10
+    unsigned char* PMem;                                                 // +0x14
+    CVolumeLockedBox() {}
+    CVolumeLockedBox(const CVolumeLockedBox& o) : Dimensions(o.Dimensions), RowPitch(o.RowPitch), SlicePitch(o.SlicePitch), PMem(o.PMem) {}
+};
+FABLE_STATIC_ASSERT(sizeof(CVolumeLockedBox) == 24);
+#endif
