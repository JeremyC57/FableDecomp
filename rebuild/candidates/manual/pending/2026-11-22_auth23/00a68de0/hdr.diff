+#ifndef FABLE_ENGINE_CVOLUMETEXTUREFILEINFO_H
+#define FABLE_ENGINE_CVOLUMETEXTUREFILEINFO_H
+// NEW shared header (AUTH23 2026-11-22, row 0x00A68DE0 CVolumeTexture::LoadFromDataStream). Ego_d.pdb CVolumeTextureFileInfo (class 0x7046B,
+// 21 bytes, field list 0x7046A, all public): Width +0x00, Height +0x02, Depth +0x04 (unsigned short), NoLevels +0x06 (unsigned char),
+// PixelFormatInit +0x07 (CPixelFormatInit, 6 bytes), UseageFlags +0x0D (unsigned long; the PDB spelling), Pool +0x11 (EVolumePool, Ego_d
+// type 0x22D9). The 21-byte header of a volume texture in a data stream: retail 0x00A68E73 reads 0x15 bytes, 0x00A68E7D passes +0x07 to
+// CPixelFormat::Initialise(const CPixelFormatInit&), 0x00A68E8F / 0x00A68EA0 read the unaligned dwords at +0x11 / +0x0D. Packed (the
+// class's own header packs it, as CPixelFormatInit.h). Needs FABLE_RETAIL_CVOLUMETEXTURE_INITIALISE (EVolumePool lives in CVolumeTexture.h).
+#include "rebuild_abi.h"
+#include "engine/CPixelFormatInit.h"
+#include "engine/CVolumeTexture.h"
+#pragma pack(push, 1)
+class CVolumeTextureFileInfo {
+public:
+    unsigned short   Width;                                              // +0x00
+    unsigned short   Height;                                             // +0x02
+    unsigned short   Depth;                                              // +0x04
+    unsigned char    NoLevels;                                           // +0x06
+    CPixelFormatInit PixelFormatInit;                                    // +0x07
+    unsigned long    UseageFlags;                                        // +0x0d
+    EVolumePool      Pool;                                               // +0x11
+};
+#pragma pack(pop)
+FABLE_STATIC_ASSERT(sizeof(CVolumeTextureFileInfo) == 21);
+#endif
