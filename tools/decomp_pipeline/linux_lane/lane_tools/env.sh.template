# source this for the Wine VC7.1 lane
S=${S:?set S to the scratch lane root}
export WINEPREFIX=$S/wine/prefix WINEARCH=win32 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" DISPLAY=
export FABLE_ROOT=/home/user/FableDecomp FABLE_VC71=$S/wine/vc71 FABLE_OBJDUMP=objdump FABLE_WINE=wine
export LANDVERIFY_WORK=$S/wine/landverify
export LINK=bufferoverflowu.lib
wineserver -p 2>/dev/null || true
# Visual C++ Toolkit 2003 (cl 13.10.3052) installed under the prefix with VCToolkitSetup.exe /s /v"/qn INSTALLDIR=C:\VCTK" (set NDP\v1.1.4322\Install=1 first)
export VC71_TOOLKIT=$S/wine/prefix/drive_c/VCTK
