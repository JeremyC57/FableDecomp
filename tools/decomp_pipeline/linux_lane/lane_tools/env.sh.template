# source this for the Wine VC7.1 lane
S=${S:?set S to the scratch lane root}
export WINEPREFIX=$S/wine/prefix WINEARCH=win32 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" DISPLAY=
export FABLE_ROOT=/home/user/FableDecomp FABLE_VC71=$S/wine/vc71rtm FABLE_OBJDUMP=objdump FABLE_WINE=wine
export LANDVERIFY_WORK=$S/wine/landverify
export LINK=bufferoverflowu.lib
wineserver -p 2>/dev/null || true
# Compilers on the Linux lane (2026-10-20): FABLE_VC71 is the RTM cl 13.10.3077 (Vc7/bin of the VS .NET 2003 disc,
# archive.org item visual-studio-2003-unpacked, VisualStudio2003.zip SHA-1 298398e607a8e6033abe261987b94cab8fb57c24,
# plus mspdb71.dll/msobj71.dll from Common7/IDE; include/lib symlinked to the DDK tree); VC71_QFE is the DDK 13.10.4035
# build used by --qfe. Keep LINK=bufferoverflowu.lib for /GS test links on both.
export VC71_QFE=$S/wine/vc71
